{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "specify",
  "small_model": "openrouter/anthropic/claude-haiku-4.5",
  "model": "openai/gpt-5.4",
  "share": "disabled",
  "instructions": ["AGENTS.md"],
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    }
  },
  "provider": {
    "openrouter": {
      "models": {
        "moonshotai/kimi-k2.6": {
          "options": {
            "provider": {
              "allow_fallbacks": false,
              "data_collection": "deny",
              "quantizations": ["fp8"]
            }
          }
        }
      }
    }
  },
  "permission": {
    "lsp": "allow",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "echo *": "allow",
      "head *": "allow",
      "cat *": "allow",
      "tail *": "allow",
      "printf *": "allow",
      "pwd": "allow",
      "git add *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git commit *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "bun build *": "allow",
      "bun test *": "allow",
      "bun run build *": "allow",
      "bun run lint *": "allow",
      "bun run typecheck *": "allow",
      "npm build *": "allow",
      "npm test *": "allow",
      "npm run build *": "allow",
      "npm run lint *": "allow",
      "npm run typecheck *": "allow",
      "npm pack --dry-run *": "allow"
    }
  }
}
